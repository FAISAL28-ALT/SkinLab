<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Prevent directory listing
Options -Indexes

# Block sensitive and hidden files
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<FilesMatch "\.(env|json|lock|git)$">
  Require all denied
</FilesMatch>
