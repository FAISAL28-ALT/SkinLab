# Database
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Application authentication (generate each secret independently with at least 32 random bytes)
JWT_ACCESS_SECRET="replace-with-at-least-32-random-bytes"
JWT_ISSUER="https://api.example.com"
JWT_AUDIENCE="skinlab-web"
AUTH_IP_HASH_SECRET="replace-with-another-32-random-bytes-secret"

# Created once by `npm run db:seed`; leave INITIAL_ADMIN_PASSWORD blank to generate
# a cryptographically random password that is printed only during first creation.
INITIAL_ADMIN_EMAIL="faisalkhancs79@gmail.com"
INITIAL_ADMIN_PASSWORD=""

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=
TRUST_PROXY_HOPS=0

# Cloudflare R2
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="skinlab-product-images"
R2_ENDPOINT="https://your-cloudflare-account-id.r2.cloudflarestorage.com"
R2_PUBLIC_BASE_URL="https://pub-your-public-bucket-id.r2.dev"
