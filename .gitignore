# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
backend/node_modules/

# ── Build outputs ─────────────────────────────────────────────────────────────
dist/
frontend/dist/
backend/dist/
*.zip

# ── Environment files ─────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
backend/.env
backend/.env.local

# ── Prisma generated ──────────────────────────────────────────────────────────
backend/node_modules/.prisma/

# ── Editor & OS ───────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo
backend/tsconfig.tsbuildinfo

# ── Test coverage ─────────────────────────────────────────────────────────────
coverage/

# ── HD product images — keep out of repository ────────────────────────────────
# Original hi-res skin images should be stored in Cloudflare R2, not here
frontend/public/assets/skins/**/*.png
# Allow small optimised webp thumbnails committed for local dev
!frontend/public/assets/skins/**/*.webp
