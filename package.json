{
  "name": "skinlab-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm ci --prefix backend --include=dev && npm --prefix backend run db:generate && npm ci --prefix frontend --include=dev && npm run build --prefix frontend",
    "start": "node backend/src/hostingerServer.js",
    "dev": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "backend:dev": "npm --prefix backend run dev",
    "backend:build": "npm --prefix backend run build",
    "db:generate": "npm --prefix backend run db:generate",
    "db:seed": "npm --prefix backend run db:seed"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
